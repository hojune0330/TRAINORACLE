+    const tampered = JSON.stringify({ ...parsed, activePlan: { ...activePlan, pairId: "plan-pair:v3:1500:rpe-only:vo2_intent:fixture-main-1-fixture-main-2:1-3-5-7-9:no-continuity" } })
