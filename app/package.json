{
  "name": "trainoracle-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --emptyOutDir=false",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:unit:kst && npm run test:release-env && npm run test:device-integration",
    "test:unit": "vitest run",
    "test:unit:kst": "vitest run -c vitest.config.kst.ts",
    "test:release-env": "node --test scripts/validate-hosted-release-env.test.mjs",
    "test:device-integration": "node --test scripts/validate-device-integration.test.mjs",
    "test:watch": "vitest",
    "test:e2e:adaptive-next-frame": "node e2e/run-adaptive-next-frame.mjs",
    "test:e2e": "npm run build && node e2e/run-full-suite.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "react-grab": "^0.1.50",
    "react-scan": "^0.5.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
